# Copy to .env (git-ignored). Compose reads it for the variables below.

# Database used by the api and workers. Compose overrides the host to `postgres`.
WEAVE_DATABASE_URL=postgresql+psycopg://weave:weave@127.0.0.1:5432/weave

# Postgres container credentials and host port (bound to 127.0.0.1 only).
POSTGRES_USER=weave
POSTGRES_PASSWORD=weave
POSTGRES_DB=weave
WEAVE_PG_PORT=5432

# Model servers (llama.cpp etc.) run on the host, not in compose. Containers reach
# them at http://host.containers.internal:<port>; they are configured in spec 02.
