# Copy to .env (git-ignored). Compose reads it for the variables below.
# A fresh checkout needs none of them: compose applies the defaults.

# Database used by the api and workers. Compose overrides the host to `postgres`.
WEAVE_DATABASE_URL=postgresql+psycopg://weave:weave@127.0.0.1:5432/weave

# Postgres container credentials and host port (bound to 127.0.0.1 only).
POSTGRES_USER=weave
POSTGRES_PASSWORD=weave
POSTGRES_DB=weave
WEAVE_PG_PORT=5432

# Published localhost ports (bound to 127.0.0.1 only). Override for an isolated compose project.
WEAVE_API_PORT=8000
WEAVE_WEB_PORT=3000
WEAVE_STANZA_PORT=8001

# Model servers (llama.cpp etc.) run on the host, not in compose. Containers reach
# them at http://host.containers.internal:<port>; they are configured in spec 02.

# Inference providers (spec 02): the catalog names these variables, never the secrets.
# Empty means missing: deployments report not ready until a real value is set and probed.
OPENROUTER_API_KEY=
TYPESAFE_API_KEY=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
# Path to the inference catalog; required by `weave inference` commands (no default).
WEAVE_INFERENCE_FILE=inference.yaml

# MCECR dataset (spec 03): host path, mounted read-only into the workers at /data/mcecr.
# Opt-in: the default stack mounts no dataset, so crawling and the API start without it.
# WEAVE_MCECR_PATH=/Users/you/Documents/crossdoc_event_coreference
